# Partner JWT from https://partners.near-intents.org (free).
# Used for the Explorer API (looks up any swap) and authenticated 1Click status calls.
NEAR_INTENTS_JWT=

# NEAR AI Cloud API key from https://cloud.near.ai (free $10 credits via https://nearbuilders.org/join).
# Used for the plain-language case summary.
NEAR_AI_API_KEY=

# Optional RPC overrides. Public endpoints are used when these are empty.
NEAR_RPC_URL=
